# Schema-checked against config/env.schema.yaml. Do not add secret values here.
GOFEATHERROUTE_CONFIG_FILE=config/defaults.yaml
GOFEATHERROUTE_ADDR=:4000
GOFEATHERROUTE_PPROF_ADDR=
GOFEATHERROUTE_LOG_LEVEL=info
GOFEATHERROUTE_REQUEST_TIMEOUT=60s
GOFEATHERROUTE_STREAM_IDLE_TIMEOUT=30s
GOFEATHERROUTE_MAX_BODY_BYTES=1048576
GOFEATHERROUTE_MAX_RESPONSE_BYTES=8388608
GOFEATHERROUTE_MAX_CONCURRENT_REQUESTS=16
GOFEATHERROUTE_MAX_CONCURRENT_EMBEDDINGS=2
GOFEATHERROUTE_MAX_CONCURRENT_STREAMS=4
GOFEATHERROUTE_ALLOW_INSECURE_HTTP=false
GOFEATHERROUTE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_API_KEY=ollama
OLLAMA_API_BASE=http://127.0.0.1:11434/v1
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
